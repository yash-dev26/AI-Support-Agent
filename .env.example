MONGODB_URI=your_mongodb_connection_string
OPENAI_API_KEY=your_openai_key

# LLM Provider Configuration (Decoupled chat completions)
# Set LLM_PROVIDER to "openai" or "grok" (or "xai").
# If LLM_PROVIDER is unset, it defaults to "grok" if GROK_API_KEY/XAI_API_KEY is present without OPENAI_API_KEY, otherwise "openai".
LLM_PROVIDER=openai
# GROK_API_KEY=your_xai_grok_key
# LLM_MODEL=grok-2            # or gpt-4.1, grok-beta, etc.
# LLM_BASE_URL=https://api.x.ai/v1

# Optional. If unset, a random secret is generated at startup — fine for
# local single-process use, but tokens won't survive a restart and won't
# be valid across multiple instances. Set a real value (e.g. `python -c
# "import secrets; print(secrets.token_hex(32))"`) for anything beyond that.
AUTH_SECRET_KEY=


