MONGODB_URI=your_mongodb_connection_string
OPENAI_API_KEY=your_openai_key

# Optional. If unset, a random secret is generated at startup — fine for
# local single-process use, but tokens won't survive a restart and won't
# be valid across multiple instances. Set a real value (e.g. `python -c
# "import secrets; print(secrets.token_hex(32))"`) for anything beyond that.
AUTH_SECRET_KEY=
